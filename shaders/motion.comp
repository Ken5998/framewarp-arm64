#version 450
#extension GL_GOOGLE_include_directive : require
#include "common.glsl"

// Block matching: for every 8x8 block of the 1/4 size luma, find where it
// was in the previous frame. A coarse search on the 1/16 size luma (4x4
// window, +-8 pixels there, so +-128 frame pixels) then a fine one on the 1/4
// size luma (8x8 block, +-3 pixels around the coarse match). The motion is
// stored in frame pixels per real frame, with the match error.

layout(local_size_x = 64) in;

const int kCoarse = 17;  // 17x17 candidates on luma2
const int kWindow = 4;   // coarse window, luma2 pixels
const int kFine = 7;     // 7x7 candidates on luma

shared float cur[kBlock * kBlock];
shared float cur2[kWindow * kWindow];
shared float sad[kCoarse * kCoarse];

float match_fine(ivec2 origin, ivec2 d, ivec2 size)
{
    float s = 0.0;
    for (int y = 0; y < kBlock; y++)
        for (int x = 0; x < kBlock; x++) {
            ivec2 q = clamp(origin + ivec2(x, y) + d, ivec2(0), size - 1);
            s += abs(texelFetch(luma_prev, q, 0).r - cur[y * kBlock + x]);
        }
    return s;
}

float match_coarse(ivec2 origin, ivec2 d, ivec2 size)
{
    float s = 0.0;
    for (int y = 0; y < kWindow; y++)
        for (int x = 0; x < kWindow; x++) {
            ivec2 q = clamp(origin + ivec2(x, y) + d, ivec2(0), size - 1);
            s += abs(texelFetch(luma2_prev, q, 0).r - cur2[y * kWindow + x]);
        }
    return s;
}

// Index of the smallest of n values in sad[], ties going to the centre.
uint pick(uint n, float zero_weight)
{
    uint centre = n / 2;
    uint best = centre;
    float best_sad = sad[centre] * zero_weight;
    for (uint i = 0; i < n; i++)
        if (sad[i] < best_sad) {
            best_sad = sad[i];
            best = i;
        }
    return best;
}

void main()
{
    ivec2 block = ivec2(gl_WorkGroupID.xy);
    uint t = gl_LocalInvocationIndex;
    ivec2 size = textureSize(luma_cur, 0);
    ivec2 size2 = textureSize(luma2_cur, 0);
    ivec2 origin = block * kBlock;
    // The 8x8 block is 2x2 luma2 pixels; the coarse window adds one around.
    ivec2 origin2 = block * (kBlock / 4) - 1;

    cur[t] = texelFetch(luma_cur, clamp(origin + ivec2(t % kBlock, t / kBlock), ivec2(0), size - 1), 0).r;
    if (t < kWindow * kWindow)
        cur2[t] = texelFetch(luma2_cur, clamp(origin2 + ivec2(t % kWindow, t / kWindow), ivec2(0), size2 - 1), 0).r;
    barrier();

    if (pc.has_prev == 0) {
        if (t == 0)
            imageStore(motion_raw, block, vec4(0.0));
        return;
    }

    for (uint i = t; i < kCoarse * kCoarse; i += 64)
        sad[i] = match_coarse(origin2, ivec2(i % kCoarse, i / kCoarse) - kCoarse / 2, size2);
    barrier();
    uint c = pick(kCoarse * kCoarse, 1.0 - pc.zero_bias);
    ivec2 coarse = (ivec2(c % kCoarse, c / kCoarse) - kCoarse / 2) * 4;
    barrier();

    if (t < kFine * kFine)
        sad[t] = match_fine(origin, coarse + ivec2(t % kFine, t / kFine) - kFine / 2, size);
    barrier();

    if (t == 0) {
        uint f = pick(kFine * kFine, coarse == ivec2(0) ? 1.0 - pc.zero_bias : 1.0);
        ivec2 d = coarse + ivec2(f % kFine, f / kFine) - kFine / 2;
        // How much the best match beats the average of its neighbourhood:
        // near 0 on flat areas (sky, road), where any vector matches.
        float mean = 0.0;
        for (int i = 0; i < kFine * kFine; i++)
            mean += sad[i];
        mean /= float(kFine * kFine);
        // The block came from origin + d, so it moves by -d per frame.
        imageStore(motion_raw, block,
                   vec4(vec2(-d * kScale), sad[f], mean - sad[f]) / vec4(1.0, 1.0, vec2(kBlock * kBlock)));
    }
}
