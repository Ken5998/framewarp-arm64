#version 450
#extension GL_GOOGLE_include_directive : require
#include "common.glsl"

layout(local_size_x = 8, local_size_y = 8) in;

// One luma pixel = the mean of a 4x4 block of the frame, from four bilinear
// taps that each average 2x2 pixels.
void main()
{
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(luma_out);
    if (any(greaterThanEqual(p, size)))
        return;
    vec2 px = 1.0 / vec2(textureSize(frame, 0));
    vec2 base = vec2(p * kScale) * px;
    vec3 c = texture(frame, base + vec2(1.0, 1.0) * px).rgb +
             texture(frame, base + vec2(3.0, 1.0) * px).rgb +
             texture(frame, base + vec2(1.0, 3.0) * px).rgb +
             texture(frame, base + vec2(3.0, 3.0) * px).rgb;
    imageStore(luma_out, p, vec4(dot(c * 0.25, vec3(0.299, 0.587, 0.114))));
}
