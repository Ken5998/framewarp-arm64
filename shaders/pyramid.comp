#version 450
#extension GL_GOOGLE_include_directive : require
#include "common.glsl"

layout(local_size_x = 8, local_size_y = 8) in;

// luma2 = the mean of 4x4 luma pixels, for the coarse motion search.
void main()
{
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(luma2_out);
    if (any(greaterThanEqual(p, size)))
        return;
    ivec2 lsize = textureSize(luma_cur, 0);
    float sum = 0.0;
    for (int y = 0; y < 4; y++)
        for (int x = 0; x < 4; x++)
            sum += texelFetch(luma_cur, min(p * 4 + ivec2(x, y), lsize - 1), 0).r;
    imageStore(luma2_out, p, vec4(sum / 16.0));
}
