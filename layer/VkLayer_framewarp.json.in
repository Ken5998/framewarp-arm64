{
    "file_format_version": "1.0.0",
    "layer": {
        "name": "VK_LAYER_FRAMEWARP_frame_generation",
        "type": "GLOBAL",
        "library_path": "@FRAMEWARP_LIBRARY_PATH@",
        "api_version": "1.3.0",
        "implementation_version": "1",
        "description": "framewarp: extra frames between the game's frames",
        "functions": {
            "vkGetInstanceProcAddr": "framewarp_GetInstanceProcAddr",
            "vkGetDeviceProcAddr": "framewarp_GetDeviceProcAddr"
        },
        "enable_environment": { "FRAMEWARP": "1" },
        "disable_environment": { "DISABLE_FRAMEWARP": "1" }
    }
}
